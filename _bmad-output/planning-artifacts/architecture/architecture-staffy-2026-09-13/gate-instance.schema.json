{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://staffy.local/schemas/gate-instance.v1.json",
  "title": "Staffy scoped gate instance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_id",
    "definition_id",
    "scope",
    "state",
    "evidence",
    "dependencies",
    "tested_at",
    "expiry_conditions",
    "approved_by",
    "permits",
    "control_generation",
    "rationale",
    "supersedes_instance_id",
    "decision_history"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "instance_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "definition_id": { "type": "string", "pattern": "^(OQ-[0-9]+[A-Z]?|AG-[1-4])$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "tenant_id": { "type": "string", "minLength": 1 },
        "release_manifest_id": { "type": "string", "minLength": 1 },
        "connector_instance_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "minLength": 1 },
        "artifact_class": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "environment": {
          "enum": ["synthetic", "closed_account_test", "controlled_real_customer", "live", "scale"]
        }
      }
    },
    "state": { "enum": ["open", "in_test", "pass", "fail", "expired", "not_applicable"] },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "uri", "sha256"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tested_at": { "type": ["string", "null"], "format": "date-time" },
    "expiry_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": { "enum": ["time", "provider_change", "account_change", "config_change", "release_change", "probe_failure", "policy_change", "manual_revoke"] },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "approved_by": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principal_id", "role", "approved_at"],
        "properties": {
          "principal_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "approved_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "permits": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "control_generation": { "type": "integer", "minimum": 0 },
    "rationale": { "type": ["string", "null"] },
    "supersedes_instance_id": { "type": ["string", "null"] },
    "decision_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "at", "actor_id"],
        "properties": {
          "from": { "enum": ["open", "in_test", "pass", "fail", "expired", "not_applicable", null] },
          "to": { "enum": ["open", "in_test", "pass", "fail", "expired", "not_applicable"] },
          "at": { "type": "string", "format": "date-time" },
          "actor_id": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "pass" } }, "required": ["state"] },
      "then": {
        "properties": {
          "evidence": { "minItems": 1 },
          "approved_by": { "minItems": 1 },
          "permits": { "minItems": 1 },
          "tested_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "not_applicable" } }, "required": ["state"] },
      "then": {
        "properties": {
          "approved_by": { "minItems": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
