    {"id":"screen-3-text","type":"text","x":758,"y":210,"width":284,"height":520,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":2110,"version":1,"versionNonce":3110,"isDeleted":false,"boundElements":null,"updated":1789320000000,"link":null,"locked":false,"index":"aA","text":"3 · ОБЪЯСНЕНИЕ И ВЫБОР\n\n«Чтобы проверить VIN и не ошибиться\nс деталью, откроем защищённую\nстраницу».\n\nЗАЧЕМ\nкакое решение изменит ввод\n\nЧТО ПЕРЕЙДЁТ\nVIN-кандидат · запрос · Case ID\nНе весь transcript по умолчанию\n\nКАК ВЕРНЁМСЯ\nрезультат придёт в этот же диалог\n\n[ Отправить ссылку ]\n[ Продолжить без media ]\n[ Позвать человека ]","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":516,"containerId":null,"originalText":"3 · ОБЪЯСНЕНИЕ И ВЫБОР\n\n«Чтобы проверить VIN и не ошибиться\nс деталью, откроем защищённую\nстраницу».\n\nЗАЧЕМ\nкакое решение изменит ввод\n\nЧТО ПЕРЕЙДЁТ\nVIN-кандидат · запрос · Case ID\nНе весь transcript по умолчанию\n\nКАК ВЕРНЁМСЯ\nрезультат придёт в этот же диалог\n\n[ Отправить ссылку ]\n[ Продолжить без media ]\n[ Позвать человека ]","lineHeight":1.25},
