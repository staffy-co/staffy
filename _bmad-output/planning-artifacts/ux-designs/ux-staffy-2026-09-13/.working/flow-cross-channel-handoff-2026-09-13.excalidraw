    {"id":"screen-9-text","type":"text","x":2978,"y":210,"width":284,"height":210,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":2122,"version":1,"versionNonce":3122,"isDeleted":false,"boundElements":null,"updated":1789320000000,"link":null,"locked":false,"index":"aM","text":"9 · ОДНО МЕСТО ОТВЕТА\n\nПосле ACKNOWLEDGED:\nRESPONSE OWNER: Антон\n\nStaffy показывает контрольный слой,\nно не создаёт второй composer.\n\nВыбор поверхности — по Capability:","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":206,"containerId":null,"originalText":"9 · ОДНО МЕСТО ОТВЕТА\n\nПосле ACKNOWLEDGED:\nRESPONSE OWNER: Антон\n\nStaffy показывает контрольный слой,\nно не создаёт второй composer.\n\nВыбор поверхности — по Capability:","lineHeight":1.25},
