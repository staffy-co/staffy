    {"id":"conversation-rule-text","type":"text","x":18,"y":70,"width":1704,"height":54,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":2102,"version":1,"versionNonce":3102,"isDeleted":false,"boundElements":null,"updated":1789320000000,"link":null,"locked":false,"index":"a2","text":"ИНВАРИАНТ · Conversation C-184 и Case сохраняются при смене канала. Переносится только разрешённый контекст; клиент видит перенесённые факты и может их исправить.","fontSize":18,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":50,"containerId":null,"originalText":"ИНВАРИАНТ · Conversation C-184 и Case сохраняются при смене канала. Переносится только разрешённый контекст; клиент видит перенесённые факты и может их исправить.","lineHeight":1.25},
