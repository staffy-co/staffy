    {"id":"screen-2-text","type":"text","x":388,"y":210,"width":284,"height":520,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":2108,"version":1,"versionNonce":3108,"isDeleted":false,"boundElements":null,"updated":1789320000000,"link":null,"locked":false,"index":"a8","text":"2 · НУЖЕН ДРУГОЙ ПУТЬ\n\nA · ЗАЩИЩЁННОЕ ПРОДОЛЖЕНИЕ\nНужны фото / VIN / документ /\nадрес / выбор / Confirmation\n\nB · ЧЕЛОВЕК\nКлиент просит человека ИЛИ\nриск / неопределённый tool result /\nполномочий Staffy недостаточно\n\nПри human_requested:\n✓ продажа прекращается\n✓ автоматические Actions стоп\n✓ собранный контекст сохраняется\n\n[ Защищённый путь → ]\n[ Передать человеку ↘ ]","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":516,"containerId":null,"originalText":"2 · НУЖЕН ДРУГОЙ ПУТЬ\n\nA · ЗАЩИЩЁННОЕ ПРОДОЛЖЕНИЕ\nНужны фото / VIN / документ /\nадрес / выбор / Confirmation\n\nB · ЧЕЛОВЕК\nКлиент просит человека ИЛИ\nриск / неопределённый tool result /\nполномочий Staffy недостаточно\n\nПри human_requested:\n✓ продажа прекращается\n✓ автоматические Actions стоп\n✓ собранный контекст сохраняется\n\n[ Защищённый путь → ]\n[ Передать человеку ↘ ]","lineHeight":1.25},
