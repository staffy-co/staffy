    {"id":"screen-1-text","type":"text","x":18,"y":210,"width":284,"height":520,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":2106,"version":1,"versionNonce":3106,"isDeleted":false,"boundElements":null,"updated":1789320000000,"link":null,"locked":false,"index":"a6","text":"1 · РАЗГОВОР\n\nВход: телефон ИЛИ чат\n(Jivo / web / иной supported)\n\nConversation C-184\nCase S-903\n\nRESPONSE OWNER\nStaffy\n\nАКТИВНЫЙ ОТВЕТ\nведущий канал\n\nФакты сохраняются с:\n• источником и временем\n• каналом\n• подтверждением клиента\n\nНовая сессия ≠ новый Case.","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":516,"containerId":null,"originalText":"1 · РАЗГОВОР\n\nВход: телефон ИЛИ чат\n(Jivo / web / иной supported)\n\nConversation C-184\nCase S-903\n\nRESPONSE OWNER\nStaffy\n\nАКТИВНЫЙ ОТВЕТ\nведущий канал\n\nФакты сохраняются с:\n• источником и временем\n• каналом\n• подтверждением клиента\n\nНовая сессия ≠ новый Case.","lineHeight":1.25},
