    {"id":"screen-10-text","type":"text","x":3348,"y":210,"width":284,"height":520,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":2124,"version":1,"versionNonce":3124,"isDeleted":false,"boundElements":null,"updated":1789320000000,"link":null,"locked":false,"index":"aO","text":"10 · ВОЗВРАТ ИЛИ FALLBACK\n\nУСПЕШНАЯ ПЕРЕДАЧА\nHuman ACTIVE → решает / уточняет\n→ RETURNED с новым summary\nOwner → Staffy, если это разрешено\nConversation C-184 продолжается\n\nНЕ ПРИНЯТО / СВЯЗЬ СОРВАНА\n✕ не показывать «человек подключён»\n→ reassignment / escalation\n→ согласованный callback\n→ другой supported канал\n→ честное завершение\n\nКлиент получает:\nимя владельца · статус · обещанный\nследующий контакт, но не fake ETA.\n\nПовторять историю не нужно.","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":516,"containerId":null,"originalText":"10 · ВОЗВРАТ ИЛИ FALLBACK\n\nУСПЕШНАЯ ПЕРЕДАЧА\nHuman ACTIVE → решает / уточняет\n→ RETURNED с новым summary\nOwner → Staffy, если это разрешено\nConversation C-184 продолжается\n\nНЕ ПРИНЯТО / СВЯЗЬ СОРВАНА\n✕ не показывать «человек подключён»\n→ reassignment / escalation\n→ согласованный callback\n→ другой supported канал\n→ честное завершение\n\nКлиент получает:\nимя владельца · статус · обещанный\nследующий контакт, но не fake ETA.\n\nПовторять историю не нужно.","lineHeight":1.25},
