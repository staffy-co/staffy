    {"id":"screen-5-text","type":"text","x":1498,"y":210,"width":284,"height":520,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":2114,"version":1,"versionNonce":3114,"isDeleted":false,"boundElements":null,"updated":1789320000000,"link":null,"locked":false,"index":"aE","text":"5 · ЛИЧНОСТЬ ДО ОБЪЕДИНЕНИЯ\n\nДо раскрытия данных и merge:\n• одноразовый token\n• risk-based проверка личности\n• при B2B — проверка полномочия\n\nСОВПАДЕНИЕ ПОДТВЕРЖДЕНО\n→ продолжить Conversation C-184\n\nСЛАБОЕ / ДВОЙНОЕ СОВПАДЕНИЕ\n→ не объединять автоматически\n→ review или новая ссылка\n\nЧувствительная причина не видна\nтретьему лицу / voicemail.\n\n[ Подтвердить и продолжить → ]","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":516,"containerId":null,"originalText":"5 · ЛИЧНОСТЬ ДО ОБЪЕДИНЕНИЯ\n\nДо раскрытия данных и merge:\n• одноразовый token\n• risk-based проверка личности\n• при B2B — проверка полномочия\n\nСОВПАДЕНИЕ ПОДТВЕРЖДЕНО\n→ продолжить Conversation C-184\n\nСЛАБОЕ / ДВОЙНОЕ СОВПАДЕНИЕ\n→ не объединять автоматически\n→ review или новая ссылка\n\nЧувствительная причина не видна\nтретьему лицу / voicemail.\n\n[ Подтвердить и продолжить → ]","lineHeight":1.25},
