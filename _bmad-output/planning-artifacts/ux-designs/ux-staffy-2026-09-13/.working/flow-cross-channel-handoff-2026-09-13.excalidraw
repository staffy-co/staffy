    {"id":"screen-8-text","type":"text","x":2608,"y":210,"width":284,"height":520,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":2120,"version":1,"versionNonce":3120,"isDeleted":false,"boundElements":null,"updated":1789320000000,"link":null,"locked":false,"index":"aK","text":"8 · ПЕРЕДАЧА ЧЕЛОВЕКУ\n\nhuman_requested / risk / unknown\n\n1  REQUESTED\nOwner: Staffy · reply заморожен\n2  ASSIGNED\nкандидат: Антон · ещё не помощь\n3  ACKNOWLEDGED\nOwner → Антон · один раз\n4  ACTIVE\nотвечает только человек\n5  RETURNED\nOwner → Staffy · явный возврат\n\nЧеловеку переданы:\nпричина · summary · факты/споры\nrisk · tool results · next action\n\nКлиент видит owner и следующий шаг.","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":516,"containerId":null,"originalText":"8 · ПЕРЕДАЧА ЧЕЛОВЕКУ\n\nhuman_requested / risk / unknown\n\n1  REQUESTED\nOwner: Staffy · reply заморожен\n2  ASSIGNED\nкандидат: Антон · ещё не помощь\n3  ACKNOWLEDGED\nOwner → Антон · один раз\n4  ACTIVE\nотвечает только человек\n5  RETURNED\nOwner → Staffy · явный возврат\n\nЧеловеку переданы:\nпричина · summary · факты/споры\nrisk · tool results · next action\n\nКлиент видит owner и следующий шаг.","lineHeight":1.25},
