    {"id":"screen-7-text","type":"text","x":2238,"y":210,"width":284,"height":520,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":2118,"version":1,"versionNonce":3118,"isDeleted":false,"boundElements":null,"updated":1789320000000,"link":null,"locked":false,"index":"aI","text":"7 · РЕЗУЛЬТАТ В ТОМ ЖЕ ДИАЛОГЕ\n\nConversation C-184 обновлён.\nНового lead / order не создано.\n\nВЕДУЩИЙ КАНАЛ\n✓ ЗАВЕРШЕНО — данные приняты\nили\n○ СРОК ИСТЁК — безопасный retry\n○ ОТМЕНЕНО — ожидание прекращено\n\nStaffy сообщает только факт:\nчто принято · что спорно\nчто выполнено / не выполнено\nследующий безопасный шаг\n\nRESPONSE OWNER: Staffy\nACTIVE REPLY: ведущий канал\n\n[ Продолжить ]  [ Нужен человек ]","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":516,"containerId":null,"originalText":"7 · РЕЗУЛЬТАТ В ТОМ ЖЕ ДИАЛОГЕ\n\nConversation C-184 обновлён.\nНового lead / order не создано.\n\nВЕДУЩИЙ КАНАЛ\n✓ ЗАВЕРШЕНО — данные приняты\nили\n○ СРОК ИСТЁК — безопасный retry\n○ ОТМЕНЕНО — ожидание прекращено\n\nStaffy сообщает только факт:\nчто принято · что спорно\nчто выполнено / не выполнено\nследующий безопасный шаг\n\nRESPONSE OWNER: Staffy\nACTIVE REPLY: ведущий канал\n\n[ Продолжить ]  [ Нужен человек ]","lineHeight":1.25},
