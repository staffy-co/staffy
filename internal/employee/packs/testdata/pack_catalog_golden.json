            "label": "Модель",
            "kind": "text"
          },
          {
            "key": "vehicle.year_of_manufacture",
            "label": "Год выпуска",
            "kind": "integer",
            "min": 1900,
            "max": 2100
          },
          {
            "key": "vehicle.trim",
            "label": "Модификация",
            "kind": "text",
            "optional": true
          },
          {
            "key": "vehicle.engine",
            "label": "Двигатель",
            "kind": "text",
            "optional": true
          }
        ],
        "alternative_sets": [
          [
            "vehicle.vin"
          ],
          [
            "vehicle.make",
            "vehicle.model",
            "vehicle.year_of_manufacture"
          ]
        ]
      },
      "part_requests": {
        "material_keys": [
          {
            "key": "part.kind",
            "label": "Деталь",
            "kind": "text",
            "role": "part_kind"
          },
          {
            "key": "part.side",
            "label": "Сторона",
            "kind": "text",
            "optional": true
          },
          {
            "key": "part.quantity",
            "label": "Количество",
            "kind": "integer",
            "min": 1,
            "max": 999
          },
          {
            "key": "part.preference",
            "label": "Предпочтение",
            "kind": "enum",
            "values": [
              "original",
              "analogs",
              "both"
            ],
            "role": "preference"
          },
          {
            "key": "part.oem_number",
            "label": "OEM-номер",
            "kind": "text",
            "role": "oem_number"
          },
          {
            "key": "part.symptom",
            "label": "Симптом",
            "kind": "text",
            "role": "symptom"
          },
          {
            "key": "part.budget",
            "label": "Бюджет",
            "kind": "text",
            "optional": true
          },
          {
            "key": "part.deadline",
            "label": "Срок",
            "kind": "text",
            "optional": true
          },
          {
            "key": "part.brands",
            "label": "Приемлемые бренды",
            "kind": "text",
            "optional": true
          },
          {
            "key": "part.constraints",
            "label": "Ограничения",
            "kind": "text",
            "optional": true
          }
        ],
        "modes": [
          {
            "mode": "diagnostic",
            "label": "Диагностика по симптому",
            "priority": 1,
            "requires": [
              "part.symptom"
